generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  username        String            @unique
  name            String?
  passwordHash    String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  progress        Progress[]
  enrollments     TrackEnrollment[]
  examAttempts    ExamAttempt[]
  checklistItems  ChecklistItem[]
  roadmap         UserRoadmap?
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  trackSlug   String
  lessonSlug  String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackSlug, lessonSlug])
  @@index([userId, trackSlug])
}

model TrackEnrollment {
  id        String   @id @default(cuid())
  userId    String
  trackSlug String
  startedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackSlug])
  @@index([userId])
}

model ExamAttempt {
  id               String   @id @default(cuid())
  userId           String
  trackSlug        String
  stageSlug        String
  format           String
  score            Int
  passed           Boolean
  questionsJson    String
  answersJson      String
  fingerprintsJson String
  feedbackJson     String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, trackSlug, stageSlug])
}

model ChecklistItem {
  id         String   @id @default(cuid())
  userId     String
  trackSlug  String
  lessonSlug String
  itemKey    String
  checked    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackSlug, lessonSlug, itemKey])
  @@index([userId, trackSlug, lessonSlug])
}

model UserRoadmap {
  id               String   @id @default(cuid())
  userId           String   @unique
  level            String
  field            String
  language         String
  framework        String
  trackSequence    String
  currentTrackSlug String
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
