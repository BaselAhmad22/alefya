# Neon Postgres (production + local). Create free at https://console.neon.tech
# DATABASE_URL = pooled (-pooler host). DIRECT_URL = direct host (migrations).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="generate-a-long-random-secret"
AUTH_TRUST_HOST=true

# Optional: AI Helper + exam grading
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Real email (pick ONE) ---
# A) Resend (recommended): https://resend.com/api-keys
#    Free: send from onboarding@resend.dev to your own inbox
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="AlefYa <onboarding@resend.dev>"

# B) SMTP (Gmail App Password, Resend SMTP, etc.)
# EMAIL_FROM="AlefYa <your@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password

# C) Ethereal preview SMTP (not a real inbox — opens a preview URL)
# MAIL_MODE=ethereal

# Realtime chat (Socket.io) — used by web + Flutter
# Local: http://localhost:4001  |  Render: https://alefya-realtime.onrender.com
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
REALTIME_PORT=4001
# Render sets PORT automatically; CORS must be the web origin:
# REALTIME_CORS_ORIGIN=https://alefya-web.onrender.com
# NEXT_PUBLIC_APP_URL=https://alefya-web.onrender.com
